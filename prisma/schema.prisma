generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  AGENT
  MANAGER
}

enum LeadStatus {
  OPEN
  CLOSED
}

// Pure identity — no hierarchy, no leads, no commissions
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      Role     @default(AGENT)
  createdAt DateTime @default(now())

  // One user has one hierarchy record
  hierarchy       UserHierarchy?     @relation("UserHierarchy")
  // One manager can appear in many hierarchy rows
  subordinates    UserHierarchy[]    @relation("ManagerHierarchy")
  leadAssignments LeadAssignment[]
  commissions     CommissionLedger[]

  @@map("users")
}

// Reporting structure — separate from user identity
model UserHierarchy {
  id        String   @id @default(cuid())
  userId    String   @unique
  managerId String?
  createdAt DateTime @default(now())

  // The user this record belongs to (1:1)
  user    User  @relation("UserHierarchy", fields: [userId], references: [id])
  // The manager (many users can share one manager → many-to-one)
  manager User? @relation("ManagerHierarchy", fields: [managerId], references: [id])

  @@map("user_hierarchy")
}

// Pure lead data — no user reference
model Lead {
  id        String     @id @default(cuid())
  title     String
  revenue   Decimal    @db.Decimal(12, 2)
  status    LeadStatus @default(OPEN)
  createdAt DateTime   @default(now())
  closedAt  DateTime?

  assignment     LeadAssignment?
  commissions    CommissionLedger[]
  companyLedger  CompanyLedger?
  statusLogs     LeadStatusLog[]

  @@map("leads")
}

// Bridge: who owns which lead — unique per lead
model LeadAssignment {
  id         String   @id @default(cuid())
  userId     String
  leadId     String   @unique
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  lead Lead @relation(fields: [leadId], references: [id])

  @@map("lead_assignments")
}

// Flat commission records — unique per (user, lead)
model CommissionLedger {
  id        String   @id @default(cuid())
  userId    String
  leadId    String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  lead Lead @relation(fields: [leadId], references: [id])

  @@unique([userId, leadId])
  @@map("commission_ledger")
}

// Explicit company share per lead — unique per lead
model CompanyLedger {
  id        String   @id @default(cuid())
  leadId    String   @unique
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id])

  @@map("company_ledger")
}

// Append-only audit trail for all status transitions
model LeadStatusLog {
  id         String     @id @default(cuid())
  leadId     String
  fromStatus LeadStatus
  toStatus   LeadStatus
  changedAt  DateTime   @default(now())

  lead Lead @relation(fields: [leadId], references: [id])

  @@map("lead_status_log")
}
